root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

[*.{xaml,csproj,props,targets}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2
end_of_line = lf

[*.md]
end_of_line = lf
trim_trailing_whitespace = false
