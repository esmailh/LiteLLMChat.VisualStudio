<UserControl x:Class="LiteLLM.VisualStudio.DashboardControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:local="clr-namespace:LiteLLM.VisualStudio">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/LiteLLM.VisualStudio;component/ThemeResources.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <!-- Two pages rather than one long one: providers and MCP servers are configured at different times, and a
      provider list that kept scrolling under the MCP controls made both harder to read. The Connections page is the
      page that was here before; the tab strip is the only thing added around it. -->
 <Grid Background="{DynamicResource {x:Static ui:EnvironmentColors.ToolWindowBackgroundBrushKey}}">
  <TabControl x:Name="Pages">
   <TabItem Header="Connections">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
     <Border Grid.Row="0" Background="{DynamicResource {x:Static ui:EnvironmentColors.EnvironmentBackgroundBrushKey}}" BorderBrush="{DynamicResource {x:Static ui:EnvironmentColors.ToolWindowBorderBrushKey}}" BorderThickness="0,0,0,1" Padding="16,10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel x:Name="HeaderText" Margin="0,0,12,0"><TextBlock Text="AI providers" Style="{StaticResource PageTitle}"/><TextBlock Text="Manage AI providers and available models" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
      <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="Refresh models" Click="Refresh_Click"/><Button Content="＋  Add server" Style="{StaticResource PrimaryButton}" Click="Add_Click"/></StackPanel>
     </Grid></Border>
     <!-- The rows are the shell's own list rows: the ListBoxItem carries the padding, the hover band and the selection
          band, so the template only has to lay the content out. -->
     <ListBox x:Name="Servers" Grid.Row="1" Margin="16,10,16,8" SelectionChanged="Servers_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Provider}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding BaseUrl}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/></StackPanel><CheckBox Grid.Column="1" Content="Enabled" Margin="10,0,0,0" VerticalAlignment="Center" IsChecked="{Binding Enabled}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
     <StackPanel x:Name="ServerActions" Grid.Row="2" Margin="16,0,16,6" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Edit" Click="Edit_Click"/><Button Content="Test connection" Click="Test_Click"/><Button Content="Remove" Style="{StaticResource DangerButton}" Click="Remove_Click"/></StackPanel>
     <Grid Grid.Row="3" Margin="16,6,16,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel x:Name="ModelsHeaderText" Margin="0,0,12,0"><TextBlock Text="Models" Style="{StaticResource SectionTitle}"/><TextBlock Text="Choose which models appear in Chat" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="UsageSummary" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
      <Grid x:Name="ModelFilters" Grid.Column="1" VerticalAlignment="Bottom"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="ServerFilter" Grid.Column="0" Width="190" Margin="0,0,8,0" ToolTip="Filter models by server" SelectionChanged="Filter_Changed"/><TextBox x:Name="Search" Grid.Column="1" Width="240" ToolTip="Search models" TextChanged="Filter_Changed"/></Grid>
     </Grid>
     <ListBox x:Name="Models" Grid.Row="4" Margin="16,0,16,14"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding Enabled}" Checked="ModelEnabled_Changed" Unchecked="ModelEnabled_Changed"/><TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding Usage}" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="{Binding UsageDetail}"/><Border Grid.Column="3" Style="{StaticResource Tag}" MaxWidth="170" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Text="{Binding Server}" FontSize="11" Foreground="{DynamicResource {x:Static ui:CommonDocumentColors.SupportTextBrushKey}}" TextTrimming="CharacterEllipsis"/></Border></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
    </Grid>
   </TabItem>
   <TabItem Header="MCP">
    <local:McpDashboardControl x:Name="McpPanel"/>
   </TabItem>
  </TabControl>
 </Grid>
</UserControl>
