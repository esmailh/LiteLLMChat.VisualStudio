<Window x:Class="LiteLLM.VisualStudio.ServerDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
        Title="LiteLLM server" Width="520" MinWidth="420" MinHeight="360" MaxHeight="760" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/LiteLLM.VisualStudio;component/ThemeResources.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Background="{DynamicResource {x:Static ui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource {x:Static ui:EnvironmentColors.EnvironmentBackgroundBrushKey}}" BorderBrush="{DynamicResource {x:Static ui:EnvironmentColors.ToolWindowBorderBrushKey}}" BorderThickness="0,0,0,1" Padding="18,14"><StackPanel><TextBlock Text="Server connection" Style="{StaticResource PageTitle}"/><TextBlock Text="Connect to a LiteLLM or OpenAI-compatible endpoint" Style="{StaticResource Caption}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0" Focusable="False"><StackPanel Margin="18,14,12,14"><TextBlock Text="Display name"/><TextBox x:Name="NameBox" Margin="0,4,0,12"/><TextBlock Text="Base URL"/><TextBox x:Name="UrlBox" Margin="0,4,0,3"/><TextBlock Text="Example: https://api.example.com" Style="{StaticResource Caption}" Margin="0,0,0,12" TextTrimming="CharacterEllipsis"/><TextBlock Text="API key"/><PasswordBox x:Name="KeyBox" Margin="0,4,0,3" ToolTip="Leave blank while editing to retain the saved key"/><TextBlock Text="Stored securely with Windows Data Protection" Style="{StaticResource Caption}" Margin="0,0,0,12" TextTrimming="CharacterEllipsis"/><CheckBox x:Name="EnabledBox" Content="Enable this connection"/></StackPanel></ScrollViewer>
  <Border Grid.Row="2" Background="{DynamicResource {x:Static ui:EnvironmentColors.EnvironmentBackgroundBrushKey}}" BorderBrush="{DynamicResource {x:Static ui:EnvironmentColors.ToolWindowBorderBrushKey}}" BorderThickness="0,1,0,0" Padding="18,10"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True"/><Button Content="Save connection" IsDefault="True" Click="Save_Click"/></StackPanel></Border>
 </Grid>
</Window>
