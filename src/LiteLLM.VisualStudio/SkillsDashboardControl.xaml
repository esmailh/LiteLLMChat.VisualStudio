<UserControl x:Class="LiteLLM.VisualStudio.SkillsDashboardControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/LiteLLM.VisualStudio;component/ThemeResources.xaml"/></ResourceDictionary.MergedDictionaries>
  <DataTemplate x:Key="SkillRowTemplate"><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <!-- Click rather than Checked/Unchecked: a rebuild of the list must not look like the user turning a skill on. -->
   <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Click="SkillEnabled_Click" VerticalAlignment="Top" Margin="0,2,8,0" ToolTip="Offer this skill to the chat. The state is kept per path, so one copy of a duplicate can be turned off without turning off the other."/>
   <StackPanel Grid.Column="1">
    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
    <Grid Margin="0,1,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
     <TextBlock Grid.Column="1" Text="{Binding State}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis">
      <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><DataTrigger Binding="{Binding HasProblem}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
    </Grid>
   </StackPanel>
  </Grid></DataTemplate>
  <DataTemplate x:Key="ResourceRowTemplate"><Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="8,0,0,0"/></Grid></DataTemplate>
 </ResourceDictionary></UserControl.Resources>
 <Grid Background="{DynamicResource {x:Static ui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="{DynamicResource {x:Static ui:EnvironmentColors.EnvironmentBackgroundBrushKey}}" BorderBrush="{DynamicResource {x:Static ui:EnvironmentColors.ToolWindowBorderBrushKey}}" BorderThickness="0,0,0,1" Padding="16,10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel x:Name="HeaderText" Margin="0,0,12,0"><TextBlock Text="Skills" Style="{StaticResource PageTitle}"/><TextBlock Text="Reusable instructions stored as SKILL.md folders. A skill guides a reply; it never grants a permission or runs a script." Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
   <WrapPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="Refresh" Click="Refresh_Click" ToolTip="Scan the configured folders again."/><ComboBox x:Name="ImportScopeBox" Width="96" Margin="4,0" ToolTip="Where an imported skill is copied"><ComboBoxItem Content="Personal" Tag="personal" IsSelected="True"/><ComboBoxItem Content="Project" Tag="project"/></ComboBox><Button Content="Import…" Click="Import_Click" ToolTip="Copy a skill folder into the directory chosen to its left."/><Button Content="＋  New skill" Style="{StaticResource PrimaryButton}" Click="New_Click"/></WrapPanel>
  </Grid></Border>

  <Expander Grid.Row="1" Header="Locations and behaviour" Margin="16,8,16,0">
   <StackPanel Margin="0,8,0,4">
    <WrapPanel><CheckBox x:Name="EnableSkillsBox" Content="Enable skills" Margin="0,0,18,0" ToolTip="Turn the whole feature off without deleting anything. The skill menu, /skill and the skill tools all go away."/><CheckBox x:Name="AutomaticBox" Content="Offer the catalog automatically" Margin="0,0,18,0" ToolTip="On the LiteLLM backend the model is given each skill's name and description and loads a body with load_skill when it is relevant. Off means only an explicit selection is sent."/><CheckBox x:Name="CompatibleBox" Content="Also scan .github/skills and .claude/skills" ToolTip="The configured project folder has precedence, then these two, then the personal folder."/></WrapPanel>
    <Grid Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBlock Text="Personal folder" VerticalAlignment="Center"/><TextBox x:Name="PersonalBox" Grid.Column="1" Margin="8,0,0,4" ToolTip="Empty uses %USERPROFILE%\.llm123\skills. This is the folder a personal skill is created in."/>
     <TextBlock Grid.Row="1" Text="Project folder" VerticalAlignment="Center"/><TextBox x:Name="ProjectBox" Grid.Row="1" Grid.Column="1" Margin="8,0,0,4" ToolTip="Relative to the open solution, or absolute. Empty uses .agents/skills. A new project skill is created here."/>
     <TextBlock Grid.Row="2" Grid.Column="1" Text="Project skills are read from the solution that is open. A configured absolute path is scanned as it is." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
    </Grid>
    <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0"><Button Content="Save settings" Click="SaveSettings_Click"/><Button Content="Open personal folder" Click="OpenPersonal_Click"/></WrapPanel>
   </StackPanel>
  </Expander>

  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" MinWidth="260"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="1.6*" MinWidth="300"/></Grid.ColumnDefinitions>
   <Grid Grid.Column="0" Margin="16,10,8,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBox x:Name="SearchBox" Margin="0,0,0,8" ToolTip="Search by name, description, folder or scope" TextChanged="Search_Changed"/>
    <Grid Grid.Row="1"><ListBox x:Name="SkillList" SelectionChanged="SkillList_SelectionChanged" ItemTemplate="{StaticResource SkillRowTemplate}"/><TextBlock x:Name="EmptyText" Text="No skill was found. Create one, import a folder, or check the locations above." Style="{StaticResource Caption}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Visibility="Collapsed"/></Grid>
    <TextBlock x:Name="ProblemsText" Grid.Row="2" Style="{StaticResource Caption}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
   </Grid>
   <Border Grid.Column="1" Width="1" Margin="0,10,0,12" Background="{DynamicResource {x:Static ui:EnvironmentColors.ToolWindowBorderBrushKey}}"/>
   <Grid Grid.Column="2" Margin="8,10,16,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
     <TextBlock x:Name="DetailTitle" Text="Select a skill" Style="{StaticResource PageTitle}" TextTrimming="CharacterEllipsis"/>
     <TextBlock x:Name="DetailDescription" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
     <TextBlock x:Name="DetailSource" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
     <TextBlock x:Name="DetailState" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
     <TextBlock x:Name="DetailWarnings" Style="{StaticResource Caption}" Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <TextBlock x:Name="ResourcesHeader" Text="Resources" Style="{StaticResource SectionTitle}" Visibility="Collapsed"/>
     <ListBox x:Name="ResourceList" ItemTemplate="{StaticResource ResourceRowTemplate}" MaxHeight="220" Margin="0,4,0,0" Visibility="Collapsed"/>
     <TextBlock x:Name="DefinitionText" Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer>
    <WrapPanel Grid.Row="2" Margin="0,10,0,0"><Button x:Name="EditButton" Content="Edit…" Click="Edit_Click" IsEnabled="False"/><Button x:Name="OpenFolderButton" Content="Open folder" Click="OpenFolder_Click" IsEnabled="False"/><Button x:Name="DeleteButton" Content="Delete…" Style="{StaticResource DangerButton}" Click="Delete_Click" IsEnabled="False"/></WrapPanel>
   </Grid>
  </Grid>

  <Border Grid.Row="3" BorderBrush="{DynamicResource {x:Static ui:EnvironmentColors.ToolWindowBorderBrushKey}}" BorderThickness="0,1,0,0" Padding="16,6"><TextBlock x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap"/></Border>
 </Grid>
</UserControl>
