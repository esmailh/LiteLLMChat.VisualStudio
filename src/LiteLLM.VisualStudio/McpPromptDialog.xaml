<Window x:Class="LiteLLM.VisualStudio.McpPromptDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
        Title="MCP prompt" Width="560" Height="520" MinWidth="420" MinHeight="300" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/LiteLLM.VisualStudio;component/ThemeResources.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Background="{DynamicResource {x:Static ui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource {x:Static ui:EnvironmentColors.EnvironmentBackgroundBrushKey}}" BorderBrush="{DynamicResource {x:Static ui:EnvironmentColors.ToolWindowBorderBrushKey}}" BorderThickness="0,0,0,1" Padding="18,14"><StackPanel><TextBlock x:Name="PromptTitle" Text="Prompt" Style="{StaticResource PageTitle}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="PromptDescription" Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0" Focusable="False"><StackPanel Margin="18,14,12,14"><StackPanel x:Name="ArgumentsPanel"/><TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
  <Border Grid.Row="2" Background="{DynamicResource {x:Static ui:EnvironmentColors.EnvironmentBackgroundBrushKey}}" BorderBrush="{DynamicResource {x:Static ui:EnvironmentColors.ToolWindowBorderBrushKey}}" BorderThickness="0,1,0,0" Padding="18,10"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True"/><Button x:Name="InsertButton" Content="Insert into prompt" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Insert_Click"/></StackPanel></Border>
 </Grid>
</Window>
