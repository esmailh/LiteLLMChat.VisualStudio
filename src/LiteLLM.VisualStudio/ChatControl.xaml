<UserControl x:Class="LiteLLM.VisualStudio.ChatControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/LiteLLM.VisualStudio;component/ThemeResources.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <!-- Every colour here is a Visual Studio token, resolved by DynamicResource straight out of the shell's own theme
      dictionary, so the tool window repaints when the shell repaints and from the same brushes. -->
 <Grid Background="{DynamicResource {x:Static ui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource {x:Static ui:EnvironmentColors.EnvironmentBackgroundBrushKey}}" BorderBrush="{DynamicResource {x:Static ui:EnvironmentColors.ToolWindowBorderBrushKey}}" BorderThickness="0,0,0,1" Padding="14,10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <!-- The glyph sits on the shell's default-button face, which is the one Visual Studio pairs with its own label
        colour chosen to read on that face — so this label is legible whatever the theme's accent happens to be. -->
   <Border Width="30" Height="30" CornerRadius="2" Background="{DynamicResource {x:Static ui:EnvironmentColors.AccentMediumBrushKey}}" VerticalAlignment="Center"><TextBlock Text="✦" Foreground="{DynamicResource {x:Static ui:CommonControlsColors.ButtonDefaultTextBrushKey}}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <StackPanel x:Name="HeaderBrand" Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center"><TextBlock Text="Chat" Style="{StaticResource SectionTitle}" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock Text="Your AI pair for this solution" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/></StackPanel>
   <!-- The controls live in one wrapping row rather than in a column each. A Grid sizes its Auto columns to content
        and never lets them give width back, so once the pane was narrower than the six of them the brand column was
        driven to nothing and the two drop-downs were drawn over each other. A WrapPanel takes the width it is given
        and puts what does not fit on the next line, which is what makes a narrow pane readable. -->
     <WrapPanel x:Name="HeaderTools" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
    <!-- Both lists are the width of their box, so both need an entry that trims rather than one that wraps or is clipped:
         the template the ComboBox would generate for a plain value has no TextTrimming of its own. This is the other end
         of the same rule the store keeps for titles — a conversation's name is one line, see ChatStateLimits.OneLine. -->
     <ComboBox x:Name="SessionBox" MinWidth="100" MaxWidth="180" Margin="0,0,4,0" VerticalAlignment="Center" VerticalContentAlignment="Center" DisplayMemberPath="DisplayTitle" ToolTip="Conversations for the current solution" SelectionChanged="SessionBox_SelectionChanged"/>
    <!-- Bound to the model itself, which reaches its text through ModelInfo.ToString() — the id and the server together,
         because the catalog deliberately keeps two servers' models of the same id apart. -->
     <Button x:Name="NewChatButton" Content="＋" VerticalAlignment="Center" Style="{StaticResource SubtleButton}" Click="Clear_Click" ToolTip="Start a new conversation"/>
    <!-- Beside New chat because it acts on the same thing — the conversation the history drop-down is showing — and in
         the quiet button style rather than a red one: the warning belongs in the confirmation, not on a header that is
         on screen the whole time. -->
     <Button x:Name="DeleteChatButton" Content="🗑" VerticalAlignment="Center" Style="{StaticResource SubtleButton}" Click="DeleteChat_Click" IsEnabled="False" ToolTip="Delete this conversation"/>
   </WrapPanel>
  </Grid></Border>
  <ScrollViewer x:Name="ConversationScroll" Grid.Row="1" Padding="24,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="ConversationScroll_ScrollChanged"><StackPanel x:Name="Messages" MaxWidth="980" HorizontalAlignment="Stretch"><StackPanel x:Name="EmptyState" HorizontalAlignment="Center" Margin="20,60,20,30"><TextBlock Text="✦" Foreground="{DynamicResource {x:Static ui:EnvironmentColors.AccentMediumBrushKey}}" FontSize="26" HorizontalAlignment="Center"/><TextBlock Text="How can I help you today?" Style="{StaticResource PageTitle}" HorizontalAlignment="Center" Margin="0,14,0,6"/><TextBlock Text="Ask a question, describe a task, or type @ for a solution file, # for an MCP tool, and / for a skill or command." Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/><WrapPanel x:Name="Suggestions" HorizontalAlignment="Center" Margin="0,18,0,0" MaxWidth="640"><Button Content="Explain the open file" Tag="Explain the file that is open in the editor." Style="{StaticResource SubtleButton}" Click="Suggestion_Click"/><Button Content="Find a likely bug" Tag="Look for a likely bug in this solution and explain how to fix it." Style="{StaticResource SubtleButton}" Click="Suggestion_Click"/><Button Content="Summarize the solution" Tag="Summarize what this solution does and how it is organised." Style="{StaticResource SubtleButton}" Click="Suggestion_Click"/></WrapPanel></StackPanel></StackPanel></ScrollViewer>
  <Grid x:Name="ComposerHost" Grid.Row="2" Margin="24,8,24,18" MaxWidth="980" HorizontalAlignment="Stretch"><Border Style="{StaticResource ComposerCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <!-- Context appears above the prompt, matching VS Code Chat's attached-file strip. -->
   <WrapPanel x:Name="ContextBar" Grid.Row="0" Margin="4,0,4,6" Visibility="Collapsed"/>
     <Grid Grid.Row="1"><TextBox x:Name="Composer" MinHeight="62" MaxHeight="200" AcceptsReturn="True" TextWrapping="Wrap" CaretBrush="White" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" PreviewKeyDown="Composer_PreviewKeyDown" TextChanged="Composer_TextChanged" ToolTip="Enter to send, Shift+Enter for a new line"/><TextBlock x:Name="ComposerHint" IsHitTestVisible="False" Margin="2,8,0,0" VerticalAlignment="Top" Foreground="{DynamicResource {x:Static ui:CommonDocumentColors.SupportTextBrushKey}}"/>
      <Popup x:Name="SlashCommandPopup" PlacementTarget="{Binding ElementName=Composer}" Placement="Top" StaysOpen="False" AllowsTransparency="True" Focusable="False"><Border MinWidth="360" MaxWidth="620" MaxHeight="240" Margin="0,0,0,6" Padding="4" Background="{DynamicResource {x:Static ui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" BorderBrush="{DynamicResource {x:Static ui:EnvironmentColors.ToolWindowBorderBrushKey}}" BorderThickness="1"><ListBox x:Name="SlashCommandList" PreviewMouseLeftButtonUp="SlashCommandList_PreviewMouseLeftButtonUp" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><Grid Margin="6,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FlowDirection="LeftToRight"/><TextBlock Grid.Column="1" Margin="14,0,4,0" Text="{Binding Description}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource {x:Static ui:CommonDocumentColors.SupportTextBrushKey}}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border></Popup>
     </Grid>
   <Grid Grid.Row="2" Margin="4,3,4,2">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <!-- First row: chat tools and selectors. -->
    <Grid Grid.Row="0" Margin="0,0,0,8">
     <WrapPanel x:Name="ComposerTools" HorizontalAlignment="left" Orientation="Horizontal" FlowDirection="LeftToRight"><Button x:Name="HamburgerButton" Content="☰" Style="{StaticResource SubtleButton}" Click="Hamburger_Click" ToolTip="Chat actions"/><ComboBox x:Name="ModelBox" MinWidth="80" MaxWidth="200" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Id" StaysOpenOnEdit="True" Tag="DropUp" Margin="2,0,4,0" ToolTip="Search models"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding ShortId}" ToolTip="{Binding Id}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><ComboBox x:Name="BackendBox" Width="105" Tag="DropUp" Margin="0,0,4,0" ToolTip="Execution backend" SelectionChanged="BackendBox_SelectionChanged"><ComboBoxItem Content="LiteLLM" Tag="litellm"/><ComboBoxItem Content="Claude Code" Tag="claude"/></ComboBox><ComboBox x:Name="ModeBox" Width="90" Tag="DropUp" SelectedIndex="1" ToolTip="Agent type" SelectionChanged="ModeBox_SelectionChanged"><ComboBoxItem Content="Ask" Tag="ask"/><ComboBoxItem Content="Agent" Tag="agent"/><ComboBoxItem Content="Plan" Tag="plan"/></ComboBox></WrapPanel>
    </Grid>
    <!-- Second row: execution state and send controls. -->
    <Grid Grid.Row="1">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <TextBlock x:Name="StateText" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Style="{StaticResource Caption}"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="StopButton" Content="■  Stop" Style="{StaticResource SubtleButton}" Click="Stop_Click" IsEnabled="False" Visibility="Collapsed"/><Button x:Name="SendButton" Content="➤" Style="{StaticResource PrimaryButton}" Click="Send_Click" ToolTip="Send (Enter)" MinWidth="34"/></StackPanel>
    </Grid>
   </Grid>
  </Grid></Border></Grid>
 </Grid>
</UserControl>

