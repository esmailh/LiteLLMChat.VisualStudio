<Window x:Class="LiteLLM.VisualStudio.SkillEditorDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
        Title="Skill" Width="900" MinWidth="640" Height="780" MinHeight="560" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/LiteLLM.VisualStudio;component/ThemeResources.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Background="{DynamicResource {x:Static ui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="{DynamicResource {x:Static ui:EnvironmentColors.EnvironmentBackgroundBrushKey}}" BorderBrush="{DynamicResource {x:Static ui:EnvironmentColors.ToolWindowBorderBrushKey}}" BorderThickness="0,0,0,1" Padding="18,14"><StackPanel><TextBlock x:Name="HeaderTitle" Text="New skill" Style="{StaticResource PageTitle}"/><TextBlock x:Name="HeaderText" Text="A SKILL.md folder the chat can use. The draft is text until you save it; nothing is run." Style="{StaticResource Caption}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>

  <StackPanel Grid.Row="1" Margin="18,14,18,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,10,0"><TextBlock Text="Name — lowercase letters, digits and hyphens; it becomes the folder name"/><TextBox x:Name="NameBox" Margin="0,4,0,0" MaxLength="64"/></StackPanel>
    <StackPanel Grid.Column="1" x:Name="ScopePanel"><TextBlock Text="Save to"/><ComboBox x:Name="ScopeBox" Margin="0,4,0,0"><ComboBoxItem Content="Personal skills" Tag="personal" IsSelected="True"/><ComboBoxItem Content="Project skills" Tag="project"/></ComboBox></StackPanel>
   </Grid>
   <TextBlock Text="Description — one specific sentence saying when to use it" Margin="0,10,0,0"/><TextBox x:Name="DescriptionBox" Margin="0,4,0,0" MaxLength="1024" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40" MaxHeight="70" VerticalScrollBarVisibility="Auto"/>
   <TextBlock x:Name="LocationText" Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap"/>

   <Expander Header="Notes for the draft — examples and conventions" Margin="0,10,0,0">
    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,8,0"><TextBlock Text="Examples or situations where the skill applies"/><TextBox x:Name="ExamplesBox" Margin="0,4,0,0" AcceptsReturn="True" MinHeight="54" MaxHeight="100" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="Conventions and constraints to follow"/><TextBox x:Name="ConventionsBox" Margin="0,4,0,0" AcceptsReturn="True" MinHeight="54" MaxHeight="100" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/></StackPanel>
    </Grid>
   </Expander>
  </StackPanel>

  <WrapPanel Grid.Row="2" Margin="18,10,18,6"><Button x:Name="GenerateButton" Content="Generate draft with AI" Style="{StaticResource PrimaryButton}" Click="Generate_Click" ToolTip="Uses the utility model if one is configured, otherwise the model the chat is using. The answer is shown for review; it is not saved."/><Button x:Name="StopButton" Content="Stop" Click="Stop_Click" Visibility="Collapsed"/><Button Content="Insert template" Click="Template_Click" ToolTip="A starter body to edit by hand when no model is available."/><TextBlock x:Name="BusyText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0"/></WrapPanel>

  <Grid Grid.Row="3" Margin="18,0,18,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBlock Text="SKILL.md — frontmatter and instructions. Edit anything the draft got wrong." Style="{StaticResource Caption}"/>
   <TextBox x:Name="ContentBox" Grid.Row="1" Margin="0,4,0,0" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas, Courier New" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" MinHeight="220"/>
  </Grid>

  <StackPanel Grid.Row="4" Margin="18,8,18,0">
   <TextBlock x:Name="StateText" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
   <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
  </StackPanel>

  <Border Grid.Row="5" Background="{DynamicResource {x:Static ui:EnvironmentColors.EnvironmentBackgroundBrushKey}}" BorderBrush="{DynamicResource {x:Static ui:EnvironmentColors.ToolWindowBorderBrushKey}}" BorderThickness="0,1,0,0" Padding="18,10" Margin="0,8,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" Click="Cancel_Click"/><Button x:Name="SaveButton" Content="Save skill" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/></StackPanel></Border>
 </Grid>
</Window>
